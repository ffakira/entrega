<% icon_class = local_assigns.fetch(:class_name, "size-5") %>
<% icon_name = local_assigns.fetch(:name) %>

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="<%= icon_class %>"
  aria-hidden="true">
  <% case icon_name %>
  <% when :menu %>
    <path d="M4 7h16M4 12h16M4 17h16"/>
  <% when :close %>
    <path d="m18 6-12 12M6 6l12 12"/>
  <% when :phone %>
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7A2 2 0 0 1 22 16.92z"/>
  <% when :message %>
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/>
  <% when :arrow %>
    <path d="M7 17 17 7M7 7h10v10"/>
  <% when :bag %>
    <path d="M6 7h12l1 14H5L6 7z"/>
    <path d="M9 7a3 3 0 0 1 6 0"/>
  <% when :clock %>
    <circle cx="12" cy="12" r="10"/>
    <path d="M12 6v6l4 2"/>
  <% when :info %>
    <circle cx="12" cy="12" r="10"/>
    <path d="M12 16v-4M12 8h.01"/>
  <% end %>
</svg>
