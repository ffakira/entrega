<main class="mx-auto max-w-6xl px-4 py-10">
  <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-sm font-medium uppercase tracking-widest text-neutral-500">
        AKARI / ADMINISTRAÇÃO
      </p>

      <h1 class="mt-2 text-3xl font-bold tracking-tight">
        Categorias
      </h1>

      <p class="mt-2 text-neutral-600">
        Organize as categorias utilizadas no cadastro de produtos e no menu.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Produtos",
        products_path,
        class: "rounded-lg border border-neutral-300 px-5 py-3 text-sm font-medium hover:bg-neutral-50" %>

      <%= link_to "Nova categoria",
        new_product_category_path,
        class: "rounded-lg bg-neutral-900 px-5 py-3 text-sm font-medium text-white hover:bg-neutral-700" %>
    </div>
  </header>

  <% if flash[:notice].present? %>
    <p class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <% if flash[:alert].present? %>
    <p class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <% if @product_categories.empty? %>
    <div class="rounded-xl border border-neutral-200 p-8 text-center">
      <p class="text-neutral-600">
        Nenhuma categoria cadastrada.
      </p>

      <%= link_to "Cadastrar primeira categoria",
        new_product_category_path,
        class: "mt-4 inline-block font-medium underline" %>
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-neutral-200">
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-600">
          <tr>
            <th class="px-5 py-4 font-medium">Categoria</th>
            <th class="px-5 py-4 font-medium">Descrição</th>
            <th class="px-5 py-4 font-medium">Ordem</th>
            <th class="px-5 py-4 font-medium">Estado</th>
            <th class="px-5 py-4 text-right font-medium">Ações</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-neutral-200">
          <% @product_categories.each do |category| %>
            <tr>
              <td class="px-5 py-4 font-medium text-neutral-900">
                <%= category.name %>
              </td>

              <td class="px-5 py-4 text-neutral-600">
                <%= category.description.presence || "Sem descrição" %>
              </td>

              <td class="px-5 py-4 tabular-nums">
                <%= category.sort_order %>
              </td>

              <td class="px-5 py-4">
                <% if category.active? %>
                  <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800">
                    Ativa
                  </span>
                <% else %>
                  <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600">
                    Inativa
                  </span>
                <% end %>
              </td>

              <td class="px-5 py-4">
                <div class="flex flex-wrap justify-end gap-3">
                  <%= link_to "Editar",
                    edit_product_category_path(category),
                    class: "font-medium underline" %>

                  <%= button_to(
                    category.active? ? "Desativar" : "Ativar",
                    status_product_category_path(category),
                    method: :patch,
                    class: "font-medium text-neutral-600 underline"
                  ) %>

                  <%= button_to(
                    "Excluir",
                    product_category_path(category),
                    method: :delete,
                    form: {
                      data: {
                        turbo_confirm: "Tem certeza de que deseja excluir esta categoria?"
                      }
                    },
                    class: "font-medium text-red-700 underline"
                  ) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</main>
