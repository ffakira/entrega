<section
  id="pedido"
  aria-labelledby="order-heading"
  class="relative isolate overflow-hidden bg-akari-text py-24 text-akari-background sm:py-32">

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 bg-[url('/images/pattern-background.jpeg')] bg-repeat bg-[length:420px_auto] opacity-[0.07] mix-blend-screen"></div>

  <img
    src="/images/sakura-branch.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="pointer-events-none absolute -right-16 -top-12 z-0 w-64 rotate-[-12deg] opacity-20 sm:-right-20 sm:-top-20 sm:w-[26rem]">

  <div class="relative z-10 mx-auto w-full max-w-[1440px] px-[5%]">

    <header class="mb-14 flex items-center justify-between border-b border-white/15 pb-6 sm:mb-20">
      <p class="flex items-center gap-3 font-jost text-xs uppercase tracking-[0.3em] text-[#DDA9B6]">
        <span class="h-px w-8 bg-[#DDA9B6]"></span>
        Peça AKARI
      </p>
      <p lang="ja" class="font-cormorant text-xl tracking-[0.2em] text-white/35">ご注文</p>
    </header>

    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:items-center lg:gap-12">

      <div class="lg:col-span-5">
        <p class="mb-7 font-jost text-[10px] uppercase tracking-[0.25em] text-white/40">
          Comida japonesa feita na hora
        </p>

        <h2 id="order-heading" class="max-w-3xl font-cormorant text-6xl font-light leading-[0.95] tracking-tight sm:text-7xl lg:text-[88px]">
          Seu próximo
          <span class="italic text-[#DDA9B6]">prato favorito</span>
          começa aqui<span class="text-akari-red">.</span>
        </h2>

        <p class="mt-8 max-w-md font-dm-sans text-base leading-8 text-white/55 sm:text-lg">
          Escolha como prefere pedir. Pelo nosso site, você monta seu pedido com praticidade. Pelo WhatsApp, nossa equipe atende você diretamente.
        </p>

        <div class="mt-10 flex items-center gap-4">
          <span class="h-px w-10 bg-akari-red"></span>
          <p class="font-jost text-[10px] uppercase tracking-[0.2em] text-white/40">
            Você escolhe. Nós preparamos.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 gap-px border border-white/15 bg-white/15 sm:grid-cols-2">

          <a href="/checkout" class="group flex min-h-[340px] flex-col justify-between bg-akari-background p-7 text-akari-text transition-colors duration-300 hover:bg-white sm:p-9">
            <div>
              <div class="mb-10 flex items-start justify-between">
                <span class="font-jost text-[10px] uppercase tracking-[0.25em] text-akari-red">Opção 01</span>
                <%= render "shared/icon", name: :bag, class_name: "size-6 text-akari-red" %>
              </div>

              <h3 class="font-cormorant text-4xl font-light leading-tight sm:text-5xl">
                Peça pelo <span class="italic text-akari-red">nosso site.</span>
              </h3>

              <p class="mt-5 max-w-xs font-dm-sans text-sm leading-7 text-akari-text/65">
                Explore o cardápio, escolha seus pratos e monte seu pedido em poucos passos.
              </p>
            </div>

            <div class="mt-10 flex items-center justify-between border-t border-akari-text/15 pt-5">
              <span class="font-jost text-xs uppercase tracking-[0.12em]">Fazer pedido online</span>
              <span class="flex size-10 items-center justify-center bg-akari-red text-white transition-transform duration-300 group-hover:translate-x-1">
                <%= render "shared/icon", name: :arrow, class_name: "size-5" %>
              </span>
            </div>
          </a>

          <a
            href="https://wa.me/5548996667779?text=Ol%C3%A1!%20Gostaria%20de%20fazer%20um%20pedido."
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-[340px] flex-col justify-between bg-[#332E28] p-7 transition-colors duration-300 hover:bg-[#3C352E] sm:p-9">

            <div>
              <div class="mb-10 flex items-start justify-between">
                <span class="font-jost text-[10px] uppercase tracking-[0.25em] text-[#DDA9B6]">Opção 02</span>
                <%= render "shared/icon", name: :message, class_name: "size-6 text-[#DDA9B6]" %>
              </div>

              <h3 class="font-cormorant text-4xl font-light leading-tight text-akari-background sm:text-5xl">
                Peça pelo <span class="italic text-[#DDA9B6]">WhatsApp.</span>
              </h3>

              <p class="mt-5 max-w-xs font-dm-sans text-sm leading-7 text-white/55">
                Prefere conversar? Entre em contato diretamente com nossa equipe e faça seu pedido.
              </p>
            </div>

            <div class="mt-10 flex items-center justify-between border-t border-white/15 pt-5">
              <span class="font-jost text-xs uppercase tracking-[0.12em] text-akari-background">Conversar e pedir</span>
              <span class="flex size-10 items-center justify-center bg-akari-red text-white transition-transform duration-300 group-hover:translate-x-1">
                <%= render "shared/icon", name: :arrow, class_name: "size-5" %>
              </span>
            </div>
          </a>
        </div>

        <div class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-jost text-[10px] uppercase tracking-[0.2em] text-white/40">
            Também estamos nos aplicativos
          </p>

          <div class="flex items-center gap-5">
            <span class="font-dm-sans text-sm text-white/70">iFood</span>
            <span class="h-4 w-px bg-white/20"></span>
            <span class="font-dm-sans text-sm text-white/70">99Food</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-20 flex items-center justify-between border-t border-white/10 pt-6">
      <p class="font-jost text-[10px] uppercase tracking-[0.25em] text-white/35">AKARI · Comida japonesa</p>
      <p lang="ja" class="font-cormorant text-lg tracking-[0.2em] text-[#DDA9B6]/60">心を込めて</p>
    </div>
  </div>
</section>
