<main class="mx-auto max-w-6xl px-4 py-10">
  <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-sm font-medium uppercase tracking-widest text-neutral-500">
        AKARI / ADMINISTRAÇÃO
      </p>

      <h1 class="mt-2 text-3xl font-bold tracking-tight">
        Produtos
      </h1>

      <p class="mt-2 text-neutral-600">
        Gerencie os produtos disponíveis no menu.
      </p>
    </div>

    <%= link_to "Novo produto",
      new_product_path,
      class: "rounded-lg bg-neutral-900 px-5 py-3 text-sm font-medium text-white hover:bg-neutral-700" %>
  </header>

  <% if flash[:notice].present? %>
    <p class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <% if @products.empty? %>
    <div class="rounded-xl border border-neutral-200 p-8 text-center">
      <p class="text-neutral-600">
        Nenhum produto cadastrado.
      </p>

      <%= link_to "Cadastrar primeiro produto",
        new_product_path,
        class: "mt-4 inline-block font-medium underline" %>
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-neutral-200">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-600">
          <tr>
            <th class="px-5 py-4 font-medium">Imagem</th>
            <th class="px-5 py-4 font-medium">Produto</th>
            <th class="px-5 py-4 font-medium">Categoria</th>
            <th class="px-5 py-4 font-medium">Preço</th>
            <th class="px-5 py-4 font-medium">Ordem</th>
            <th class="px-5 py-4 font-medium">Estado</th>
            <th class="px-5 py-4 text-right font-medium">Ações</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-neutral-200">
          <% @products.each do |product| %>
            <tr>
              <td class="px-5 py-4">
                <% if product.image.attached? %>
                  <%= image_tag product.image.variant(:thumbnail),
                    alt: product.name,
                    class: "h-16 w-16 rounded-lg object-cover",
                    loading: "lazy",
                    decoding: "async" %>
                <% else %>
                  <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-neutral-100 text-xs text-neutral-400">
                    Sem imagem
                  </div>
                <% end %>
              </td>

              <td class="px-5 py-4">
                <p class="font-medium text-neutral-900">
                  <%= product.name %>
                </p>

                <% if product.description.present? %>
                  <p class="mt-1 max-w-xs truncate text-neutral-500">
                    <%= product.description %>
                  </p>
                <% end %>
              </td>

              <td class="px-5 py-4 text-neutral-600">
                <%= product.product_category.name %>
              </td>

              <td class="px-5 py-4 font-medium tabular-nums">
                <%= number_to_currency(
                  product.price_cents / 100.0,
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
              </td>

              <td class="px-5 py-4 tabular-nums">
                <%= product.sort_order %>
              </td>

              <td class="px-5 py-4">
                <% if product.active? %>
                  <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800">
                    Ativo
                  </span>
                <% else %>
                  <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600">
                    Inativo
                  </span>
                <% end %>
              </td>

              <td class="px-5 py-4">
                <div class="flex justify-end gap-3">
                  <%= link_to "Editar",
                    edit_product_path(product),
                    class: "font-medium underline" %>

                  <%= button_to(
                    product.active? ? "Desativar" : "Ativar",
                    status_product_path(product),
                    method: :patch,
                    class: "font-medium text-neutral-600 underline"
                  ) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</main>
