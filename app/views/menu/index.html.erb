<main class="mx-auto max-w-6xl px-4 py-10">
  <header class="mb-10">
    <p class="text-sm font-medium uppercase tracking-widest text-neutral-500">
      AKARI
    </p>

    <h1 class="mt-2 text-4xl font-bold tracking-tight">
      Nosso menu
    </h1>

    <p class="mt-3 text-neutral-600">
      Preparado na hora, com cuidado em cada detalhe.
    </p>
  </header>

  <% if @products_by_category.empty? %>
    <p class="rounded-lg border border-neutral-200 p-6 text-neutral-600">
      Nosso menu está sendo atualizado. Volte em breve.
    </p>
  <% else %>
    <div class="space-y-10">
      <% @products_by_category.each do |category, products| %>
        <section>
          <h2 class="mb-5 border-b border-neutral-200 pb-3 text-2xl font-semibold">
            <%= category %>
          </h2>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% products.each do |product| %>
              <article class="rounded-xl border border-neutral-200 p-5">
                <h3 class="font-semibold text-neutral-900">
                  <%= product.name %>
                </h3>

                <% if product.description.present? %>
                  <p class="mt-2 text-sm text-neutral-600">
                    <%= product.description %>
                  </p>
                <% end %>

                <p class="mt-4 font-semibold text-neutral-900">
                  <%= number_to_currency(
                    product.price_cents / 100.0,
                    unit: "R$ ",
                    separator: ",",
                    delimiter: "."
                  ) %>
                </p>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</main>
